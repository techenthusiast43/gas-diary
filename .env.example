# ========================================================
# GasDiary Environment Variables (Template)
# ========================================================

# Reown AppKit / WalletConnect Project ID (from https://cloud.reown.com)
VITE_REOWN_PROJECT_ID=your_reown_project_id_here

# Hardhat Deployer Private Key for BOT Chain Mainnet
PRIVATE_KEY=your_private_key_here

# Deployed GasDiary Contract Address on BOT Chain Mainnet
VITE_GAS_DIARY_CONTRACT=0x5a04E7558461121941eC2A52a019D6F577437A6C

# BOT Chain Mainnet Parameters
VITE_BOT_RPC_URL=https://rpc.botchain.ai
VITE_BOT_CHAIN_ID=677
VITE_BOT_EXPLORER_URL=https://scan.botchain.ai
