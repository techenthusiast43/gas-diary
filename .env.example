# ========================================================
# GasDiary Environment Variables (Template)
# ========================================================

# Reown AppKit / WalletConnect Project ID (from https://cloud.reown.com)
VITE_REOWN_PROJECT_ID=your_reown_project_id_here

# Hardhat Deployer Private Key for BOT Chain Testnet
PRIVATE_KEY=your_private_key_here

# Optional: Deployed GasDiary Contract Address
VITE_GAS_DIARY_CONTRACT=

# BOT Chain Network Parameters
VITE_BOT_RPC_URL=https://rpc.bohr.life
VITE_BOT_CHAIN_ID=968
VITE_BOT_EXPLORER_URL=https://scan.bohr.life
